<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    ============================================================================
    Kernel Telemetry Engine — app.config
    ============================================================================

    ⚠ THIS FILE IS NOT READ AT RUNTIME. ⚠

    All runtime configuration is via environment variables, consumed by
    src/KernelTelemetry.Engine/Configuration/TelemetryOptions.cs. The
    System.Configuration.ConfigurationManager NuGet package is NOT
    referenced; no code path calls ConfigurationManager.AppSettings.

    Editing the <appSettings> block below has NO EFFECT on the running
    process. To change runtime behaviour, set the corresponding
    environment variable before launching the engine.

    Environment variable reference (see README.md § Configuration):

      KERNEL_TELEMETRY_SOCKET         default: /var/run/kernel_telemetry.sock
      KERNEL_TELEMETRY_PID            default: /var/run/kernel_telemetry.pid
      KERNEL_TELEMETRY_DATA           default: /var/lib/kernel-telemetry/data
      KERNEL_TELEMETRY_LOG            default: /var/log/kernel-telemetry
      KERNEL_TELEMETRY_ALLOWED_UIDS   default: 0,<engine-uid>

    Why this file exists at all:

      MSBuild auto-discovers app.config in the project root and emits
      KernelTelemetry.Engine.dll.config alongside the binary. Enterprise
      deployment pipelines often assert "the .dll.config exists and has
      the expected runtime section". This file satisfies that assertion
      and documents the intent, without adding runtime baggage.

    What actually controls GC and threading:

      KernelTelemetry.Engine.csproj sets:
        <ServerGarbageCollection>true</ServerGarbageCollection>
        <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
        <TieredPGO>true</TieredPGO>

      These produce the runtimeconfig.json knobs the CLR reads at
      startup. The <runtime> section below documents what the csproj
      sets — it is inert for .NET 8/9 (runtimeconfig.json wins).
    ============================================================================
  -->

  <runtime>
    <!--
      Documentation mirror of the .csproj settings. The CLR reads
      runtimeconfig.json (generated from csproj) first, so these
      entries are informational only.
    -->
    <gcServer enabled="true" />
    <gcConcurrent enabled="true" />
  </runtime>

  <appSettings>
    <!--
      Operator reference — mirrors the environment variables read by
      TelemetryOptions.cs. Edit the ENVIRONMENT, not this file.
    -->
    <add key="KERNEL_TELEMETRY_SOCKET"          value="/var/run/kernel_telemetry.sock" />
    <add key="KERNEL_TELEMETRY_PID"             value="/var/run/kernel_telemetry.pid" />
    <add key="KERNEL_TELEMETRY_DATA"            value="/var/lib/kernel-telemetry/data" />
    <add key="KERNEL_TELEMETRY_LOG"             value="/var/log/kernel-telemetry" />
    <add key="KERNEL_TELEMETRY_ALLOWED_UIDS"    value="0,1000" />
  </appSettings>
</configuration>